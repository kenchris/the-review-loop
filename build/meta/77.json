[{"id": "headline", "x": 112, "y": 260, "w": 1560, "h": 287.015625, "size": 92, "lh": 95.68, "align": "start", "spacing": -2, "runs": [{"t": "Whoever prompted the change is on the hook for it. ", "color": "rgb(242, 245, 250)", "bold": true, "mono": false}, {"t": "An agent's approval never counts as a person's.", "color": "rgb(61, 217, 255)", "bold": true, "mono": false}]}, {"id": "sub", "x": 112, "y": 603, "w": 1360, "h": 113.375, "size": 42, "lh": 56.7, "align": "start", "spacing": 0, "runs": [{"t": "The gate checks that a review was written. It never replaces the person who signs off.", "color": "rgb(201, 211, 232)", "bold": false, "mono": false}]}, {"id": "source", "x": 112, "y": 1007.40625, "w": 1696, "h": 28.59375, "size": 22, "lh": 28.6, "align": "start", "spacing": 0, "runs": [{"t": "Osmani, Lunt and Wang, \"How the Claude Code team does code review\", 15 October 2026.", "color": "rgb(138, 151, 177)", "bold": false, "mono": false}]}]
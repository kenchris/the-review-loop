[{"id": "headline", "x": 112, "y": 132, "w": 1696, "h": 92.390625, "size": 88, "lh": 92.4, "align": "start", "spacing": -1.5, "runs": [{"t": "/triage on ", "color": "rgb(242, 245, 250)", "bold": true, "mono": false}, {"t": "a real round", "color": "rgb(61, 217, 255)", "bold": true, "mono": false}]}, {"id": "caption", "x": 1202, "y": 290, "w": 606, "h": 345.734375, "size": 38, "lh": 49.4, "align": "start", "spacing": -0.5, "runs": [{"t": "40 undecided threads on five pull requests, more than the skill reads in one go. So it split them by pull request, started three read-only readers and said it would check their proposals before showing anything.", "color": "rgb(242, 245, 250)", "bold": true, "mono": false}]}, {"id": "co0", "x": 1268, "y": 671.734375, "w": 540, "h": 78, "size": 30, "lh": 39, "align": "start", "spacing": 0, "runs": [{"t": "The skill's own limit: over about 25 threads it reads in shares.", "color": "rgb(201, 211, 232)", "bold": false, "mono": false}]}, {"id": "co1", "x": 1268, "y": 775.734375, "w": 540, "h": 78, "size": 30, "lh": 39, "align": "start", "spacing": 0, "runs": [{"t": "Three readers, one share each. They edit nothing.", "color": "rgb(201, 211, 232)", "bold": false, "mono": false}]}, {"id": "co2", "x": 1268, "y": 879.734375, "w": 463.640625, "h": 48, "size": 30, "lh": 39, "align": "start", "spacing": 0, "runs": [{"t": "Nothing is recorded until I confirm.", "color": "rgb(201, 211, 232)", "bold": false, "mono": false}]}, {"id": "source", "x": 112, "y": 1007.40625, "w": 1696, "h": 28.59375, "size": 22, "lh": 28.6, "align": "start", "spacing": 0, "runs": [{"t": "Claude Code, on a work project. The three readers had run for 51 seconds when this was taken.", "color": "rgb(138, 151, 177)", "bold": false, "mono": false}]}]